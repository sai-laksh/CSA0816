put("Task1/task1_mess.py", r'''
import csv
from decimal import Decimal, InvalidOperation

def process_mess_file(filename):
    rejected = []
    processed = 0
    print("\nHOSTEL MESS BILL REPORT")
    try:
        with open(filename, "r", newline="", encoding="utf-8") as file:
            for line_no, row in enumerate(csv.reader(file), 1):
                if not row or not any(x.strip() for x in row):
                    continue
                try:
                    if len(row) != 3:
                        raise ValueError("Expected exactly 3 fields")
                    reg, name, amount_text = [x.strip() for x in row]
                    if not reg or not name:
                        raise ValueError("Register number or name is empty")
                    amount = Decimal(amount_text)
                    if amount < 0:
                        raise ValueError("Negative bill amount")
                    print(f"{reg:<10} {name:<15} Rs. {amount:.2f}")
                    processed += 1
                except (ValueError, InvalidOperation) as error:
                    rejected.append(f"Line {line_no}: {row} | {error}")
    except FileNotFoundError:
        print("Input file not found.")
        return
    except OSError as error:
        print("File error:", error)
        return
    print("Processed:", processed, "| Rejected:", len(rejected))
    for item in rejected:
        print(item)

if __name__ == "__main__":
    process_mess_file("mess_oct.txt")
''')

