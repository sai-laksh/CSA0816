# -------------------- B1: CLEANING --------------------

def load_clean(csv_text):
    """Read CSV text and return valid, unique station readings."""
    result = []
    seen = set()
    reader = csv.DictReader(io.StringIO(csv_text))
    required = {"station", "date", "pm25"}

    if not reader.fieldnames or not required.issubset(reader.fieldnames):
        raise ValueError("Required CSV columns are missing")

    for row in reader:
        try:
            # DictReader stores extra columns under the None key.
            if None in row:
                continue
            station = (row.get("station") or "").strip().title()
            date_text = (row.get("date") or "").strip()
            value_text = (row.get("pm25") or "").strip()

            if not station or not date_text or not value_text:
                continue
            if value_text.upper() == "NA":
                continue

            pm25 = float(value_text)
            if not 0 <= pm25 <= 999:
                continue

            # Accept ISO date or ISO date-time, then standardise to date.
            try:
                parsed_date = datetime.fromisoformat(date_text.replace("Z", "+00:00"))
            except ValueError:
                parsed_date = datetime.strptime(date_text, "%d-%m-%Y")
            day = parsed_date.strftime("%Y-%m-%d")

            temperature_text = (row.get("temperature") or "").strip()
            temperature = None
            if temperature_text:
                try:
                    temperature = float(temperature_text)
                except ValueError:
                    temperature = None

            record = (station, day, pm25, temperature)
            if record not in seen:
                result.append(record)
                seen.add(record)
