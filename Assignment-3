def normalize_name(name):
    name = name.lower().strip()
    titles = ["dr.", "mr.", "mrs.", "ms."]
    for title in titles:
        if name.startswith(title):
            name = name[len(title):].strip()
    return " ".join(name.split())

def normalize_phone(phone):
    digits = "".join(ch for ch in phone if ch.isdigit())
    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]
    if len(digits) == 10:
        return digits
    return None

def merge_contacts(contacts):
    merged = []
    phone_index = {}
    for contact in contacts:
        name = normalize_name(contact.get("name", ""))
        phones = {p for p in (normalize_phone(x) for x in contact.get("phones", [])) if p is not None}
        emails = {e.strip().lower() for e in contact.get('emails', []) if e.strip()}
        # Find existing matching contact records
        matches = []
        for phone in phones:
            if phone in phone_index:
                record = phone_index[phone]
                if record not in matches:
                    matches.append(record)
        if matches:
            target = matches[0]
            # Merge other matching records if necessary
            for other in matches[1:]:
                target["names"].update(other["names"])
                target["phones"].update(other["phones"])
                target["emails"].update(other["emails"])
                merged.remove(other)
            target["names"].add(name)
            target["phones"].update(phones)
            target["emails"].update(emails)
        else:
            target = {"names": {name} if name else set(), "phones": set(phones), "emails": set(emails)}
            merged.append(target)
        # Update phone lookup dictionary
        for phone in target["phones"]:
            phone_index[phone] = target
    return merged

